---
import Base from '../layouts/Base.astro';
---
<Base title="subscribed | unshittify" noindex>
<section class="wrap hero">
  <p class="prompt"><span class="dim">~/</span><span class="acc">$</span> confirm --subscription<span class="cursor" aria-hidden="true"></span></p>
  <h1>200 OK.</h1>
  <p class="lede">You're on the list. One email a week with the new projects, and nothing in weeks with nothing new. Every email has an unsubscribe link.</p>
  <p><a class="btn" href="/">cd ~</a></p>
</section>
</Base>
