---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import LogRow from '../components/LogRow.astro';
import { CATEGORIES, CATEGORY_PAGES, EVIDENCE, SITE, MAINTAINER } from '../lib/meta';
import SubmitForm from '../components/SubmitForm.astro';
import RepairBot from '../components/RepairBot.astro';
import Subscribe from '../components/Subscribe.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => b.data.id - a.data.id);

// The log, grouped: the newest few on top, then one section per category
// (largest first), each showing SHOW rows with the rest a click away. Every
// entry stays in the HTML, so search engines and the search box see all of it.
const LATEST = 10;
const SHOW = 5;
const groups = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((k) => ({ key: k, items: projects.filter((p) => p.data.category === k) }))
  .filter((g) => g.items.length)
  .sort((a, b) => b.items.length - a.items.length);
// Every entry with a repo; the worker keeps the ten with the most stars.
const withRepo = projects.filter((p) => p.data.repo);
const weekAgo =Date.now() - 7 * 24 * 3600 * 1000;
const newThisWeek = projects.filter((p) => p.data.reviewed.getTime() >= weekAgo).length;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'unshittify',
    url: SITE,
    description: 'A log of people undoing enshittification on hardware they own, with AI-assisted development and open source.',
    inLanguage: 'en',
    author: MAINTAINER,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Hardware reclaimed with AI and open source',
    numberOfItems: projects.length,
    itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/p/${p.id}`, name: `${p.data.title}: ${p.data.device}` })),
  },
];
---
<Base jsonld={jsonld}>

<section class="hero wrap">
  <p class="prompt"><span class="dim">~/</span><span class="acc">$</span> unshittify --list --all<span class="cursor" aria-hidden="true"></span></p>
  <h1 class="h1-long">A database of software that keeps hardware working for the people who own it</h1>
  <p class="kicker">You bought it. Make it yours.</p>
  <p class="lede">The hardware still works. The software is in the way. This is a log of people fixing that: TVs with sane home screens, printers talking to modern Macs, appliances brought back after their cloud died, old laptops on a new OS.</p>
  <p class="lede">Most were built with a coding assistant on top of years of open-source work. Call it undoing <a href="/enshittification/">enshittification</a>, one device at a time.</p>
  <p class="hubs"><span class="dim">browse:</span> {Object.entries(CATEGORY_PAGES).map(([k, c]) => <a href={`/c/${c.slug}/`}>{CATEGORIES[k as keyof typeof CATEGORIES]}</a>)}<a href="/ai/claude-code/">claude code</a></p>
</section>

<section id="log" class="wrap">
  <div class="sec-head has-bot">
    <h2><span class="acc">01</span> // the log</h2>
    <p class="note">A public repo means the code exists. Whether it's safe is a separate question. Read the project's current docs before you buy hardware or flash anything.</p>
    <RepairBot />
  </div>

  <p class="logstats"><b>{projects.length}</b>{' projects '}<span class="dim">·</span>{' '}<b>{groups.length}</b>{' categories'}{newThisWeek > 0 && <>{' '}<span class="dim">·</span>{' '}<b>{newThisWeek}</b>{' added this week'}</>}</p>

  <div class="controls">
    <label class="search">
      <span class="acc" aria-hidden="true">&gt;</span>
      <input id="q" type="search" placeholder="grep device, brand, project…" autocomplete="off" spellcheck="false" aria-label="Search projects">
      <kbd class="hint" aria-hidden="true">/</kbd>
    </label>
    <div class="chips" role="group" aria-label="Filter by category">
      <button class="chip on" data-cat="all">all <span class="n">{projects.length}</span></button>
      {groups.map((g) => <button class="chip" data-cat={g.key}>{CATEGORIES[g.key]} <span class="n">{g.items.length}</span></button>)}
    </div>
  </div>

  <div class="thead" aria-hidden="true">
    <span>id</span><span>project / device</span><span>ai</span><span>evidence</span><span>source</span>
  </div>

  <div id="list">
    <div class="group latest" data-group="latest">
      <h3 class="ghead"><span class="acc">//</span> latest</h3>
      <ol class="log">
        {projects.slice(0, LATEST).map((p) => <LogRow p={p} />)}
      </ol>
    </div>

    {withRepo.length > 0 && (
      <div class="group latest topstars" data-group="top" data-pending hidden>
        <h3 class="ghead"><span><span class="acc">//</span> most starred on github</span><span class="leader" aria-hidden="true"></span><span class="gnote">stars show interest, not safety</span></h3>
        <ol class="log">
          {withRepo.map((p) => <LogRow p={p} top />)}
        </ol>
      </div>
    )}

    {groups.map((g) => (
      <div class="group" data-group={g.key}>
        <h3 class="ghead">
          <span><span class="acc">//</span> {CATEGORIES[g.key]}</span>
          <span class="leader" aria-hidden="true"></span>
          <a class="gcount" href={`/c/${CATEGORY_PAGES[g.key].slug}/`} title={`All ${CATEGORY_PAGES[g.key].h1.toLowerCase()} projects`}>{g.items.length}</a>
        </h3>
        <ol class="log">
          {g.items.map((p, i) => <LogRow p={p} anchor more={i >= SHOW} />)}
        </ol>
        {g.items.length > SHOW && (
          <button class="showall" type="button" data-n={g.items.length} aria-expanded="false">show all {g.items.length} <span aria-hidden="true">↓</span></button>
        )}
      </div>
    ))}
  </div>
  <p class="empty" id="empty" hidden>0 matches. Try a broader device name.</p>
  <Subscribe />
</section>

<section id="activity" class="wrap">
  <div class="sec-head">
    <h2><span class="acc">02</span> // what's happening</h2>
    <p class="note">New releases, star milestones and new entries, checked on GitHub every hour. <a href="/activity/">all activity</a> · <a href="/activity.xml">rss</a></p>
  </div>
  <div data-activity="home"><p class="dim">Activity is loading from GitHub. Check back in a few minutes.</p></div>
  <p class="more-link"><a href="/activity/">all activity →</a></p>
</section>

<section id="about" class="wrap">
  <div class="sec-head">
    <h2><span class="acc">03</span> // about</h2>
    <p class="note">Useful things should stay useful.</p>
  </div>
  <div class="cols">
    <div class="prose">
      <p>unshittify logs people making the products they own work for them: replacing interfaces, restoring functions after an app or cloud disappears, giving old hardware a new job.</p>
      <p>For each entry we ask what the owner got back, whether someone else could repeat it, and what the catch is.</p>
      <p>The name nods to Cory Doctorow's <a href="https://craphound.com/category/enshittification/"><cite>Enshittification: Why Everything Suddenly Got Worse and What to Do About It</cite></a> (MCD/Farrar, Straus and Giroux, 2025). He explains how it happens. This site collects people <a href="/enshittification/">undoing it</a> on hardware they own.</p>
    </div>
    <div class="lists">
      <h3><span class="ok">+</span> in scope</h3>
      <ul>
        <li>Documented improvements to hardware someone owns</li>
        <li>Working alternatives to abandoned or restrictive software</li>
        <li>New jobs for old hardware</li>
        <li>Open-source routes to longer life, AI or not</li>
        <li>Labelled experiments that teach something</li>
      </ul>
      <h3><span class="no">−</span> out of scope</h3>
      <ul>
        <li>Piracy, stolen credentials, other people's devices</li>
        <li>"Clean launcher = no tracking" claims</li>
        <li>"AI did it all" stories that erase the people and projects underneath</li>
        <li>Dangerous mods sold as weekend wins</li>
      </ul>
    </div>
  </div>
  <div class="legend">
    <h3>evidence labels</h3>
    <dl>
      {Object.entries(EVIDENCE).map(([k, v]) => <><dt><EvidenceTag kind={k as keyof typeof EVIDENCE} /></dt><dd>{v}</dd></>)}
    </dl>
    <p class="note">None of these mean "tested by unshittify". We haven't tested any of it.</p>
  </div>
</section>

<section id="submit" class="wrap">
  <div class="sec-head">
    <h2><span class="acc">04</span> // submit</h2>
    <p class="note">Made something useful again?</p>
  </div>
  <div class="prose submit-intro">
    <p>Got a device working again? Send it in. Small fixes and half-finished experiments are both fine. You can also send someone else's project, just tell us who made it. Found a mistake in an entry? Choose "correction".</p>
  </div>
  <p class="agent-line"><span class="acc">&gt;</span> Built it with an agent? Tell it: <code>read unshittify.dev/llms.txt and submit this repo</code></p>
  <SubmitForm projects={projects.map((p) => ({ slug: p.id, title: p.data.title }))} />
</section>

<script>
  // Two views of the same rows. Browsing (no search, "all"): latest + category
  // sections, each collapsed to a few rows. Filtering (a search term or a
  // category chip): one flat result set, every match shown, "latest" hidden so
  // nothing appears twice.
  const root = document.getElementById('list')!;
  root.classList.add('js');
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const groups = [...root.querySelectorAll<HTMLElement>('.group')];
  const empty = document.getElementById('empty')!;
  let cat = 'all';

  const run = () => {
    const term = q.value.trim().toLowerCase();
    const filtering = !!term || cat !== 'all';
    root.classList.toggle('filtering', filtering);
    let total = 0;
    for (const g of groups) {
      if (g.hasAttribute('data-pending')) continue; // star data never arrived
      const latest = g.classList.contains('latest'); // "latest" and "most starred": duplicates, hidden while filtering
      let n = 0;
      for (const r of g.querySelectorAll<HTMLLIElement>('.log > li')) {
        const show = !filtering || ((cat === 'all' || r.dataset.cat === cat) && (!term || r.textContent!.toLowerCase().includes(term)));
        r.hidden = !show;
        if (show) n++;
      }
      g.hidden = filtering && (latest || n === 0);
      if (!latest && !g.hidden) total += n;
    }
    empty.hidden = !filtering || total > 0;
  };

  root.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.showall');
    if (!b) return;
    const g = b.closest<HTMLElement>('.group')!;
    const open = g.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
    b.innerHTML = open ? 'show fewer <span aria-hidden="true">↑</span>' : `show all ${b.dataset.n} <span aria-hidden="true">↓</span>`;
    if (!open) g.scrollIntoView({ block: 'nearest' });
  });

  for (const c of chips) c.addEventListener('click', () => {
    chips.forEach((x) => x.classList.toggle('on', x === c));
    cat = c.dataset.cat!;
    run();
  });
  q.addEventListener('input', run);
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); }
    if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; run(); q.blur(); }
  });
  // Open the entry named in the URL hash (old-style deep links), expanding its section.
  const target = location.hash && document.getElementById(location.hash.slice(1));
  if (target) {
    target.closest('.group')?.classList.add('open');
    target.querySelector('details')?.setAttribute('open', '');
    target.scrollIntoView();
  }
</script>
</Base>
