---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectFields from '../components/ProjectFields.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import { CATEGORIES, CATEGORY_PAGES, EVIDENCE, SITE, MAINTAINER, pad } from '../lib/meta';
import SubmitForm from '../components/SubmitForm.astro';
import RepairBot from '../components/RepairBot.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => b.data.id - a.data.id);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'unshittify',
    url: SITE,
    description: 'A log of people undoing enshittification on hardware they own, with AI-assisted development and open source.',
    inLanguage: 'en',
    author: MAINTAINER,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Hardware reclaimed with AI and open source',
    numberOfItems: projects.length,
    itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/p/${p.id}`, name: `${p.data.title}: ${p.data.device}` })),
  },
];
---
<Base jsonld={jsonld}>

<section class="hero wrap">
  <p class="prompt"><span class="dim">~/</span><span class="acc">$</span> unshittify --list --all<span class="cursor" aria-hidden="true"></span></p>
  <h1>You bought it.<br>Make it yours.</h1>
  <p class="lede">The hardware still works. The software is in the way. This is a log of people fixing that: TVs with sane home screens, printers talking to modern Macs, appliances brought back after their cloud died, old laptops on a new OS.</p>
  <p class="lede">Most were built with a coding assistant on top of years of open-source work. Call it undoing <a href="/enshittification">enshittification</a>, one device at a time.</p>
  <p class="hubs"><span class="dim">browse:</span> {Object.entries(CATEGORY_PAGES).map(([k, c]) => <a href={`/c/${c.slug}`}>{CATEGORIES[k as keyof typeof CATEGORIES]}</a>)}<a href="/ai/claude-code">claude code</a></p>
</section>

<section id="log" class="wrap">
  <div class="sec-head has-bot">
    <h2><span class="acc">01</span> // the log</h2>
    <p class="note">A public repo means the code exists. Whether it's safe is a separate question. Read the project's current docs before you buy hardware or flash anything.</p>
    <RepairBot />
  </div>

  <div class="controls">
    <label class="search">
      <span class="acc" aria-hidden="true">&gt;</span>
      <input id="q" type="search" placeholder="grep device, brand, project…" autocomplete="off" spellcheck="false" aria-label="Search projects">
      <kbd class="hint" aria-hidden="true">/</kbd>
    </label>
    <div class="chips" role="group" aria-label="Filter by category">
      <button class="chip on" data-cat="all">all</button>
      {Object.entries(CATEGORIES).map(([k, v]) => <button class="chip" data-cat={k}>{v}</button>)}
    </div>
  </div>

  <div class="thead" aria-hidden="true">
    <span>id</span><span>project / device</span><span>ai</span><span>evidence</span><span>source</span>
  </div>

  <ol class="log" id="list">
    {projects.map(async (p) => {
      const d = p.data;
      return (
        <li data-cat={d.category} id={p.id}>
          <details>
            <summary>
              <span class="id">{pad(d.id)}</span>
              <span class="name"><b>{d.title}</b><i>{d.device}</i></span>
              <span class="ai">{d.ai}</span>
              <EvidenceTag kind={d.evidence} />
              <a class="src" href={d.links[0].url} rel="noopener">{d.links[0].label}<span aria-hidden="true"> ↗</span></a>
            </summary>
            <div class="body">
              <p>{p.body?.trim().split(/\n\s*\n/)[0]}</p>
              <ProjectFields p={d} />
              <p class="perma"><a href={`/p/${p.id}`}>/p/{p.id}</a></p>
            </div>
          </details>
        </li>
      );
    })}
  </ol>
  <p class="empty" id="empty" hidden>0 matches. Try a broader device name.</p>
</section>


<section id="about" class="wrap">
  <div class="sec-head">
    <h2><span class="acc">02</span> // about</h2>
    <p class="note">Useful things should stay useful.</p>
  </div>
  <div class="cols">
    <div class="prose">
      <p>unshittify logs people making the products they own work for them: replacing interfaces, restoring functions after an app or cloud disappears, giving old hardware a new job.</p>
      <p>For each entry we ask what the owner got back, whether someone else could repeat it, and what the catch is.</p>
      <p>The name nods to Cory Doctorow's <a href="https://craphound.com/category/enshittification/"><cite>Enshittification: Why Everything Suddenly Got Worse and What to Do About It</cite></a> (MCD/Farrar, Straus and Giroux, 2025). He explains how it happens. This site collects people <a href="/enshittification">undoing it</a> on hardware they own.</p>
    </div>
    <div class="lists">
      <h3><span class="ok">+</span> in scope</h3>
      <ul>
        <li>Documented improvements to hardware someone owns</li>
        <li>Working alternatives to abandoned or restrictive software</li>
        <li>New jobs for old hardware</li>
        <li>Open-source routes to longer life, AI or not</li>
        <li>Labelled experiments that teach something</li>
      </ul>
      <h3><span class="no">−</span> out of scope</h3>
      <ul>
        <li>Piracy, stolen credentials, other people's devices</li>
        <li>"Clean launcher = no tracking" claims</li>
        <li>"AI did it all" stories that erase the people and projects underneath</li>
        <li>Dangerous mods sold as weekend wins</li>
      </ul>
    </div>
  </div>
  <div class="legend">
    <h3>evidence labels</h3>
    <dl>
      {Object.entries(EVIDENCE).map(([k, v]) => <><dt><EvidenceTag kind={k as keyof typeof EVIDENCE} /></dt><dd>{v}</dd></>)}
    </dl>
    <p class="note">None of these mean "tested by unshittify". We haven't tested any of it.</p>
  </div>
</section>

<section id="submit" class="wrap">
  <div class="sec-head">
    <h2><span class="acc">03</span> // submit</h2>
    <p class="note">Made something useful again?</p>
  </div>
  <div class="prose submit-intro">
    <p>Got a device working again? Send it in. Small fixes and half-finished experiments are both fine. You can also send someone else's project, just tell us who made it. Found a mistake in an entry? Choose "correction".</p>
  </div>
  <p class="agent-line"><span class="acc">&gt;</span> Built it with an agent? Tell it: <code>read unshittify.dev/llms.txt and submit this repo</code></p>
  <SubmitForm projects={projects.map((p) => ({ slug: p.id, title: p.data.title }))} />
</section>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const rows = [...document.querySelectorAll<HTMLLIElement>('#list > li')];
  const empty = document.getElementById('empty')!;
  let cat = 'all';
  const run = () => {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const show = (cat === 'all' || r.dataset.cat === cat) && (!term || r.textContent!.toLowerCase().includes(term));
      r.hidden = !show;
      if (show) n++;
    }
    empty.hidden = n > 0;
  };
  for (const c of chips) c.addEventListener('click', () => {
    chips.forEach((x) => x.classList.toggle('on', x === c));
    cat = c.dataset.cat!;
    run();
  });
  q.addEventListener('input', run);
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); }
    if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; run(); q.blur(); }
  });
  // Open the entry named in the URL hash (old-style deep links).
  const target = location.hash && document.getElementById(location.hash.slice(1));
  if (target) target.querySelector('details')?.setAttribute('open', '');
</script>
</Base>
