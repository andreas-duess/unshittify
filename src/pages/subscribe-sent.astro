---
import Base from '../layouts/Base.astro';
---
<Base title="check your inbox | unshittify" noindex>
<section class="wrap hero">
  <p class="prompt"><span class="dim">~/</span><span class="acc">$</span> subscribe --weekly<span class="cursor" aria-hidden="true"></span></p>
  <h1>202 Accepted.</h1>
  <p class="lede">Check your inbox for a confirmation link. You're not subscribed until you click it. The link works for 7 days.</p>
  <p><a class="btn" href="/">cd ~</a></p>
</section>
</Base>
