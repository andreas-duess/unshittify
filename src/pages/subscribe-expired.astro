---
import Base from '../layouts/Base.astro';
---
<Base title="link expired | unshittify" noindex>
<section class="wrap hero">
  <p class="prompt"><span class="dim">~/</span><span class="acc">$</span> confirm --subscription<span class="cursor" aria-hidden="true"></span></p>
  <h1>410 Gone.</h1>
  <p class="lede">That confirmation link has expired or was mangled in transit. Sign up again from the box on the front page and use the new link within 7 days.</p>
  <p><a class="btn" href="/">cd ~</a></p>
</section>
</Base>
