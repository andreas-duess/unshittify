---
// The activity feed as a dated list. `names` caps how many new entries a
// "new" line spells out before "and N more".
import { getCollection } from 'astro:content';
import { activityLines, KIND_LABEL } from '../lib/activity';

interface Props { limit?: number; onePerProject?: boolean; names?: number }
const { limit, onePerProject = false, names = Infinity } = Astro.props;

const projects = await getCollection('projects', (p) => !p.data.draft);
const title = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
const lines = activityLines(new Set(Object.keys(title)), { limit, onePerProject });
const fmt = (n: number) => n.toLocaleString('en-US');
---
<ol class="feed">
  {lines.map((l) => (
    <li id={l.id.replace(/[^\w-]/g, '-')}>
      <span class="when">{l.date}</span>
      <span class={`ftag k-${l.kind}`}>{KIND_LABEL[l.kind]}</span>
      <p>
        {l.kind === 'added' && <>
          {l.slugs.length === 1 ? 'New entry: ' : `${l.slugs.length} new entries: `}
          {l.slugs.slice(0, names).map((s, i) => <>{i > 0 && ', '}<a href={`/p/${s}/`}>{title[s]}</a></>)}
          {l.slugs.length > names && <span class="dim"> and {l.slugs.length - names} more</span>}
        </>}
        {l.kind === 'release' && <>
          <a href={`/p/${l.slug}/`}>{title[l.slug]}</a> released <a href={l.url} rel="noopener">{l.tags[0]} ↗</a>
          {l.tags.length > 1 && <span class="dim"> and {l.tags.length - 1} more that day</span>}
        </>}
        {l.kind === 'stars' && <><a href={`/p/${l.slug}/`}>{title[l.slug]}</a> passed {fmt(l.stars)} GitHub stars</>}
        {l.kind === 'archived' && <><a href={`/p/${l.slug}/`}>{title[l.slug]}</a>: the repo was archived on GitHub, so it may no longer be maintained</>}
      </p>
    </li>
  ))}
</ol>
