---
// Newsletter signup: one email field, confirmed opt-in (see worker/index.ts).
interface Props { id?: string }
const { id = 'subscribe' } = Astro.props;
---
<form class="sub" id={id} method="post" action="/api/subscribe">
  <p class="sub-lead"><span class="acc">&gt;</span> unshittify weekly: new projects in your inbox, once a week. Nothing in weeks with nothing new.</p>
  <div class="sub-row">
    <label class="sub-field"><span class="acc" aria-hidden="true">$</span>
      <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" aria-label="Email address">
    </label>
    <label class="hp" aria-hidden="true">leave blank <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    <button type="submit">subscribe</button>
  </div>
  <p class="sub-fine">You'll get a confirmation email first. Unsubscribe any time. <a href="/privacy/">privacy</a></p>
</form>
