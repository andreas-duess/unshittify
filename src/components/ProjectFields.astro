---
import type { CollectionEntry } from 'astro:content';
interface Props { p: CollectionEntry<'projects'>['data'] }
const { p } = Astro.props;
---
<dl>
  <dt>ai</dt><dd>{p.aiRole}</dd>
  <dt>caveats</dt><dd>{p.caveats}</dd>
  <dt>evidence</dt><dd>{p.evidenceNote}</dd>
</dl>
<p class="links">
  <a class="btn src-btn" href={p.links[0].url} rel="noopener">open {p.links[0].label} ↗</a>
  {p.links.slice(1).map((l) => <a href={l.url} rel="noopener">{l.label}</a>)}
</p>
